# Peinture Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and will NOT be committed.

# Service mode: 'local' | 'server' | 'hydration'
VITE_SERVICE_MODE=local

# CORS Request Proxy Address
VITE_PROXY_URL=

# Default ModelScope token (pre-filled in Settings; can be overridden here)
# VITE_MODELSCOPE_TOKEN=ms-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
